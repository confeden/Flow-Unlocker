{
  "manifest_version": 3,
  "name": "Flow Unlocker",
  "version": "1.0.0",
  "description": "Client-side region availability compatibility for Google Flow.",
  "icons": {
    "16": "icons/waterfall-16.png",
    "32": "icons/waterfall-32.png",
    "48": "icons/waterfall-48.png",
    "128": "icons/waterfall-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://flow.google.com/*"],
      "js": ["flow-unlocker.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
